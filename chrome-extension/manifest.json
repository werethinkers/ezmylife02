{
  "manifest_version": 3,
  "name": "EzMyLife Shortcuts",
  "version": "1.1.0",
  "description": "Auto-expand your Speedy Notebook & PromptMaster shortcuts on any website",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
